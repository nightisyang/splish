# Application
HOST=0.0.0.0
PORT=8081

# Cloudflare R2 (the uploader also works with other S3-compatible services)
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=splish-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://assets.example.com
